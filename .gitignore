# Flutter
.dart_tool/
build/
.flutter-plugins
.flutter-plugins-dependencies
pubspec.lock

# Generated code is COMMITTED, not ignored: lib/src/rust/ (./scripts/frb-generate.sh) and
# lib/l10n/app_localizations*.dart (flutter gen-l10n). See CONTRIBUTING.md → "Generated code".

# l10n untranslated-keys report (regenerated via: flutter gen-l10n; must be empty)
lib/l10n/untranslated_messages.txt

# Rust
rust/target/
rust_builder/target/
# NOTE: rust/Cargo.lock IS committed to freeze the mostro-core git dependency

# General
.DS_Store
.idea/
*.log
.env
.env.*
*.iml

# Signing keys. android/.gitignore already covers android/, but a keystore generated with
# `keytool` from the repo root (docs/RELEASING.md) would land here, unignored. The release
# key must never be committed: leaked, anyone can ship an "update" to every user.
*.jks
*.keystore
android/key.properties

# Platform
ios/Pods/
ios/.symlinks/
android/.gradle/
android/local.properties
android/app/debug
android/app/profile
android/.kotlin/

# Web service worker (generated at build time)
web/flutter_service_worker.js

# Headless web smoke test (test/web/smoke): deps and failure screenshots
test/web/smoke/node_modules/
test/web/smoke/smoke-failure.png

# Golden diff output written by flutter test on a mismatch
**/test/**/failures/

# Merge / patch artifacts
*.orig
*.rej
