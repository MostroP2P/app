<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+: nothing leaves the device, neither to Google's cloud backup nor
     in a device-to-device transfer (#873). The data directory holds trade
     rows, chat messages and bond claims; the identity that produced them is
     Keystore-bound and would not come along, so a restore would only bring
     orphaned rows and skip the first run. test/ci/android_backup_test.dart
     guards this file and the manifest attributes that point at it. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </device-transfer>
</data-extraction-rules>
